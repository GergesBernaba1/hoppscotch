VITE_FEATURE_FLAG_COLLECTIONS_PER_USER="-1"
VITE_FEATURE_FLAG_MAX_REQ_IN_COLLECTION="-1"
VITE_FEATURE_FLAG_MAX_ENVS_PER_USER="-1"
VITE_FEATURE_FLAG_MAX_VARS_PER_ENV="-1"
VITE_FEATURE_FLAG_MAX_REQ_HISTORY_PER_USER="-1"
VITE_FEATURE_FLAG_MAX_TEAMS_PER_USER="-1"
