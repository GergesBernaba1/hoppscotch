# Hoppscotch Monitor Agent Configuration

# Application Settings
NODE_ENV=production
PORT=3100
LOG_LEVEL=info
MONITOR_INTERVAL=5 # Minutes between test runs

# Database Connection
DATABASE_URL="sqlserver://username:password@server:port;database=hoppscotch;trustServerCertificate=true;multipleActiveResultSets=true;applicationIntent=ReadWrite"
DB_CONNECTION_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000

# API Endpoints
HOPPSCOTCH_API_URL=http://localhost:3000
HOPPSCOTCH_GRAPHQL_ENDPOINT=http://localhost:3000/graphql
API_TIMEOUT=10000

# Authentication
AUTH_TOKEN=your_secure_token_here
AUTH_EMAIL=admin@example.com
AUTH_PASSWORD=admin_password

# Notification Settings
NOTIFY_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-url
SLACK_CHANNEL=#hoppscotch-alerts

# Auto-recovery Settings
AUTO_RECOVERY_ENABLED=true
MAX_AUTO_RECOVERY_ATTEMPTS=3
AUTO_RECOVERY_TIMEOUT=300000 # 5 minutes in ms

# Test Thresholds
QUERY_TIMEOUT_THRESHOLD=5000 # ms
CPU_USAGE_THRESHOLD=80 # percent
MEMORY_USAGE_THRESHOLD=80 # percent
ERROR_THRESHOLD=5 # Number of errors before alerting
