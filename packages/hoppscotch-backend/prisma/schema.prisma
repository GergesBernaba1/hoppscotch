datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

// SQL Server doesn't support enum types directly
// Define as string with constraint instead
model TeamMemberRole {
  value String @id // Can be 'OWNER', 'VIEWER', 'EDITOR'
}

model Team {
  id              String            @id @default(cuid())
  name            String
  members         TeamMember[]
  TeamInvitation  TeamInvitation[]
  TeamCollection  TeamCollection[]
  TeamRequest     TeamRequest[]
  TeamEnvironment TeamEnvironment[]
}

model TeamMember {
  id      String @id @default(uuid()) // Membership ID
  role    String // References TeamMemberRole value
  userUid String
  teamID  String
  team    Team   @relation(fields: [teamID], references: [id], onDelete: Cascade)

  @@unique([teamID, userUid])
}

model TeamInvitation {
  id           String @id @default(cuid())
  teamID       String
  team         Team   @relation(fields: [teamID], references: [id], onDelete: Cascade)
  creatorUid   String
  inviteeEmail String
  inviteeRole  String // References TeamMemberRole value

  @@unique([teamID, inviteeEmail])
  @@index([teamID])
}

model TeamCollection {
  id         String           @id @default(cuid())
  parentID   String?
  data       String?          // JSON stored as string
  parent     TeamCollection?  @relation("TeamCollectionChildParent", fields: [parentID], references: [id], onUpdate: NoAction, onDelete: NoAction)
  children   TeamCollection[] @relation("TeamCollectionChildParent")
  requests   TeamRequest[]
  teamID     String
  team       Team             @relation(fields: [teamID], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int
  createdOn  DateTime         @default(now())
  updatedOn  DateTime         @updatedAt
}

model TeamRequest {
  id           String         @id @default(cuid())
  collectionID String
  collection   TeamCollection @relation(fields: [collectionID], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teamID       String
  team         Team           @relation(fields: [teamID], references: [id], onDelete: Cascade, onUpdate: NoAction)
  title        String
  request      String         // JSON stored as string
  orderIndex   Int
  createdOn    DateTime       @default(now())
  updatedOn    DateTime       @updatedAt
}

model Shortcode {
  id              String   @id @unique
  request         String   // JSON stored as string
  embedProperties String?  // JSON stored as string
  creatorUid      String?
  User            User?    @relation(fields: [creatorUid], references: [uid], onUpdate: NoAction)
  createdOn       DateTime @default(now())
  updatedOn       DateTime @default(now()) @updatedAt

  @@unique(fields: [id, creatorUid], name: "creator_uid_shortcode_unique")
}

model TeamEnvironment {
  id        String @id @default(cuid())
  teamID    String
  team      Team   @relation(fields: [teamID], references: [id], onDelete: Cascade)
  name      String
  variables String // JSON stored as string
}

model User {
  uid                  String                @id @default(cuid())
  displayName          String?
  email                String?               @unique
  photoURL             String?
  isAdmin              Boolean               @default(false)
  refreshToken         String?
  providerAccounts     Account[]
  VerificationToken    VerificationToken[]
  settings             UserSettings?
  shortcodes           Shortcode[]
  userCollections      UserCollection[]
  userEnvironments     UserEnvironment[]
  userHistories        UserHistory[]
  userInvitations      UserInvitation[]
  userRequests         UserRequest[]
  currentRESTSession   String?               // JSON stored as string
  currentGQLSession    String?               // JSON stored as string
  lastLoggedOn         DateTime?
  lastActiveOn         DateTime?
  createdOn            DateTime              @default(now())
}

model Account {
  id                  String   @id @default(cuid())
  userUid             String
  user                User     @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  type                String
  provider            String
  providerAccountId   String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  providerDisplayName String?
  providerEmail       String?
  providerEmailVerified Boolean?
  providerAccountName String?
  providerScope       String?
  loggedIn            DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userUid])
}

model VerificationToken {
  id              String   @id @default(cuid())
  userUid         String
  user            User     @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  expiresOn       DateTime
  token           String   @unique
  identifier      String

  @@unique([identifier, token])
}

model UserSettings {
  id         String   @id @default(cuid())
  userUid    String   @unique
  user       User     @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  properties String   // JSON stored as string
  updatedOn  DateTime @updatedAt
}

model UserHistory {
  id               String   @id @default(cuid())
  userUid          String
  user             User     @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  reqType          String   // References ReqType value
  request          String   // JSON stored as string
  responseMetadata String   // JSON stored as string
  isStarred        Boolean
  executedOn       DateTime @default(now())
}

model UserEnvironment {
  id        String  @id @default(cuid())
  userUid   String
  user      User    @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  name      String?
  variables String  // JSON stored as string
  isGlobal  Boolean
}

model UserInvitation {
  id           String   @id @default(cuid())
  userUid      String
  user         User     @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  inviteeEmail String   @unique
  invitedOn    DateTime @default(now())
}

model UserRequest {
  id             String         @id @default(cuid())
  userCollection UserCollection @relation(fields: [collectionID], references: [id], onUpdate: NoAction)
  collectionID   String
  userUid        String
  user           User           @relation(fields: [userUid], references: [uid], onDelete: Cascade, onUpdate: NoAction)
  title          String
  request        String         // JSON stored as string
  type           String         // References ReqType value
  orderIndex     Int
  createdOn      DateTime       @default(now())
  updatedOn      DateTime       @updatedAt
}

model UserCollection {
  id         String           @id @default(cuid())
  userUid    String
  user       User             @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  title      String
  data       String?          // JSON stored as string
  orderIndex Int
  type       String           // References ReqType value
  createdOn  DateTime         @default(now())
  updatedOn  DateTime         @updatedAt
  parentID   String?
  parent     UserCollection?  @relation("ParentUserCollection", fields: [parentID], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   UserCollection[] @relation("ParentUserCollection")
  requests   UserRequest[]
}

model InfraConfig {
  id                      String   @id @default(cuid())
  name                    String   @unique
  value                   String
  lastSyncedEnvFileValue  String?
  isEncrypted             Boolean  @default(false) // Use case: Let's say, Admin wants to store a Secret Key, but doesn't want to store it in plain text in `value` column
  createdOn               DateTime @default(now())
  updatedOn               DateTime @updatedAt
}

model InfraToken {
  id        String    @id @default(cuid())
  name      String    @unique
  token     String    @unique @default(uuid())
  expiresOn DateTime?
  createdOn DateTime  @default(now())
  updatedOn DateTime  @updatedAt
}

model PersonalAccessToken {
  id        String    @id @default(cuid())
  userUid   String
  name      String
  token      String    @unique @default(uuid())
  expiresOn  DateTime?
  createdOn  DateTime  @default(now())
  updatedOn  DateTime  @default(now())
}
model InvitedUser {
  id           String   @id @default(cuid())
  adminUid     String
  adminEmail   String
  inviteeEmail String
  invitedOn    DateTime @default(now())

  @@unique([adminUid, inviteeEmail])
}
