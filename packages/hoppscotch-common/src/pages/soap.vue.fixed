<template>
  <div class="flex flex-col flex-1 bg-primary">
    <!-- New SOAP Project Modal - Direct implementation without Teleport -->
    <div v-if="showNewProjectModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50">
      <div class="bg-primary w-full max-w-md p-6 rounded-lg shadow-lg">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-xl font-bold">{{ t('soap.new_soap_project') }}</h2>
          <button @click="showNewProjectModal = false" class="text-secondary hover:text-accent">
            <svg viewBox="0 0 24 24" class="w-6 h-6">
              <path fill="currentColor" d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
            </svg>
          </button>
        </div>
        
        <div class="space-y-4">
          <!-- Project name -->
          <div>
            <label for="projectName" class="block mb-2 font-semibold">{{ t('soap.project_name') }}</label>
            <input 
              id="projectName"
              v-model="projectName"
              type="text"
              class="w-full p-2 bg-primaryLight border border-dividerLight rounded"
              :placeholder="t('soap.project_name_placeholder')"
            />
          </div>
          
          <!-- WSDL URL -->
          <div>
            <label for="wsdlUrl" class="block mb-2 font-semibold">{{ t('soap.initial_wsdl') }}</label>
            <div class="flex">
              <input 
                id="wsdlUrl"
                v-model="wsdlUrl"
                type="text"
                class="flex-1 p-2 bg-primaryLight border border-dividerLight rounded-l"
                :placeholder="t('soap.wsdl_url_placeholder')"
              />
              <button
                class="px-4 py-2 bg-primaryDark text-white hover:bg-accent border border-dividerLight rounded-r"
                @click="browseWsdlFile"
              >
                {{ t('action.browse') }}
              </button>
            </div>
          </div>
          
          <!-- Options -->
          <div class="space-y-2">
            <div class="flex items-center">
              <input 
                id="createSampleRequests"
                v-model="createSampleRequests"
                type="checkbox"
                class="mr-2"
              />
              <label for="createSampleRequests">{{ t('soap.create_sample_requests') }}</label>
            </div>
            
            <div class="flex items-center">
              <input 
                id="createTestSuite"
                v-model="createTestSuite"
                type="checkbox"
                class="mr-2"
              />
              <label for="createTestSuite">{{ t('soap.create_test_suite') }}</label>
            </div>
          </div>
        </div>
        
        <div class="flex justify-end space-x-2 mt-6">
          <button
            class="px-4 py-2 border border-dividerLight rounded hover:bg-primaryLight"
            @click="showNewProjectModal = false"
          >
            {{ t('action.cancel') }}
          </button>
          <button
            class="px-4 py-2 bg-accent text-white rounded hover:bg-accentDark"
            @click="createProject"
            :disabled="!isProjectFormValid"
          >
            {{ t('action.create') }}
          </button>
        </div>
      </div>
    </div>
    
    <HoppSmartModal
      v-if="historyStore.history.length > 0"
      :show="showConfirmTabClose"
      :title="t('action.confirm')"
      @hide-modal="showConfirmTabClose = false"
    >
      <template #body>
        <p>{{ t('soap.confirm_close_tab') }}</p>
      </template>
      <template #actions>
        <HoppButtonSecondary
          :label="t('action.cancel')"
          @click="showConfirmTabClose = false"
        />
        <HoppButtonPrimary
          :label="t('action.confirm')"
          @click="closeTab(tabToClose)"
        />
      </template>
    </HoppSmartModal>
    
    <!-- Sample saving modal -->
    <HoppSmartModal
      v-if="showSaveSampleModal"
      :title="t('soap.save_as_sample')"
      @hide-modal="showSaveSampleModal = false"
    >
      <template #body>
        <div class="flex flex-col">
          <label class="pb-2 font-semibold" for="sampleName">{{ t('name') }}</label>
          <input
            id="sampleName"
            v-model="sampleName"
            type="text"
            class="w-full px-3 py-2 border rounded"
            :placeholder="t('soap.sample_name_placeholder')"
          />
        </div>
      </template>
      <template #actions>
        <HoppButtonSecondary
          :label="t('action.cancel')"
          @click="showSaveSampleModal = false"
        />
        <HoppButtonPrimary
          :label="t('action.save')"
          @click="saveAsSample"
        />
      </template>
    </HoppSmartModal>

    <!-- Tab menu dropdown -->
    <HoppSmartModal
      v-if="showTabMenu"
      :title="t('soap.tab_actions')"
      @hide-modal="showTabMenu = false"
    >
      <template #body>
        <div class="flex flex-col">
          <button
            class="px-4 py-2 text-left hover:bg-primaryLight"
            @click="duplicateCurrentTab"
          >
            {{ t('soap.duplicate_tab') }}
          </button>
          <button
            class="px-4 py-2 text-left hover:bg-primaryLight"
            @click="openSaveSampleModal"
          >
            {{ t('soap.save_as_sample') }}
          </button>
          <button
            class="px-4 py-2 text-left hover:bg-primaryLight"
            @click="renameCurrentTab"
          >
            {{ t('soap.rename_tab') }}
          </button>
        </div>
      </template>
    </HoppSmartModal>

    <!-- Rename tab modal -->
    <HoppSmartModal
      v-if="showRenameModal"
      :title="t('soap.rename_tab')"
      @hide-modal="showRenameModal = false"
    >
      <template #body>
        <div class="flex flex-col">
          <label class="pb-2 font-semibold" for="tabName">{{ t('name') }}</label>
          <input
            id="tabName"
            v-model="tabName"
            type="text"
            class="w-full px-3 py-2 border rounded"
            :placeholder="t('soap.tab_name_placeholder')"
          />
        </div>
      </template>
      <template #actions>
        <HoppButtonSecondary
          :label="t('action.cancel')"
          @click="showRenameModal = false"
        />
        <HoppButtonPrimary
          :label="t('action.rename')"
          @click="saveTabRename"
        />
      </template>
    </HoppSmartModal>

    <!-- Main layout -->
    <div class="flex flex-col flex-1">
      <!-- Header with new project button -->
      <div class="flex items-center justify-between p-4 border-b border-dividerLight">
        <h1 class="text-xl font-bold">SOAP API</h1>
        <button
          class="px-4 py-2 bg-accent text-white rounded hover:bg-accentDark flex items-center animate-pulse"
          @click="openNewProjectModal"
        >
          <svg viewBox="0 0 24 24" class="w-5 h-5 mr-2">
            <path fill="currentColor" d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
          </svg>
          {{ t('soap.new_project') }}
        </button>
      </div>
      
      <!-- Main content with sidebar and request area -->
      <div class="flex flex-1 overflow-hidden">
        <!-- Sidebar -->
        <div class="w-64 border-r border-dividerLight flex flex-col">
          <!-- Sidebar tabs -->
          <div class="flex border-b border-dividerLight">
            <button
              class="flex-1 py-2 text-center"
              :class="{ 'bg-primaryLight border-b-2 border-accent': sidebarTab === 'history' }"
              @click="sidebarTab = 'history'"
            >
              {{ t('soap.history') }}
            </button>
            <button
              class="flex-1 py-2 text-center"
              :class="{ 'bg-primaryLight border-b-2 border-accent': sidebarTab === 'collections' }"
              @click="sidebarTab = 'collections'"
            >
              {{ t('soap.collections') }}
            </button>
          </div>
          
          <!-- Sidebar content -->
          <div class="flex-1 overflow-y-auto">
            <History v-if="sidebarTab === 'history'" />
            <Collections v-else-if="sidebarTab === 'collections'" />
          </div>
        </div>
        
        <!-- Main content area with request tabs -->
        <div class="flex flex-col flex-1 overflow-hidden">
          <HoppSmartTabs
            v-model="selectedTabID"
            :tabs="tabs"
            label-key="document.request.name"
            unique-key="id"
            class="overflow-hidden flex-1 flex flex-col"
            :closable="true"
            :enable-drag-drop="true"
            reordering-key="soap-tabs"
            @tab-close="confirmTabClose"
            @tab-add="addTab"
          >
            <template #suffix>
              <div class="flex">
                <button
                  class="flex items-center justify-center h-8 w-8 hover:bg-primaryLight"
                  @click="addTab"
                >
                  <svg viewBox="0 0 24 24" class="w-5 h-5 text-secondaryLight">
                    <path fill="currentColor" d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
                  </svg>
                </button>
              </div>
            </template>
            <template #tabhead="{ tab }">
              <div class="flex items-center">
                <span>{{ tab.document.request.name || 'New Request' }}</span>
                <button
                  class="ml-2 p-1 hover:bg-primaryLight rounded"
                  @click.stop="openTabMenu(tab.id)"
                >
                  <svg viewBox="0 0 24 24" class="w-4 h-4 text-secondaryLight">
                    <path fill="currentColor" d="M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z" />
                  </svg>
                </button>
              </div>
            </template>
            <template #tab="{ tab }">
              <div class="flex flex-col flex-1 overflow-hidden">
                <div class="flex flex-col flex-1 overflow-hidden"
                     :class="{ 'flex-row': isResponseSideBySide && tab.document.response }">
                  <div class="flex flex-col flex-1 overflow-hidden"
                       :class="{ 'w-1/2': isResponseSideBySide && tab.document.response }">
                    <Request :tabID="tab.id" />
                  </div>
                  <div v-if="tab.document.response"
                     class="flex flex-col flex-1 overflow-hidden"
                     :class="{ 'w-1/2': isResponseSideBySide }">
                    <Response :response="tab.document.response" />
                  </div>
                </div>
              </div>
            </template>
          </HoppSmartTabs>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup lang="ts">
import { ref, computed, onMounted, watch, nextTick } from "vue"
// We need to use default import for runtime, even though TypeScript expects named import
import useService from "dioc/vue"
import { useI18n } from "vue-i18n"
import { HoppSmartTabs, HoppSmartModal, HoppButtonSecondary, HoppButtonPrimary } from "@hoppscotch/ui"
import { HoppSOAPAttachment, makeSOAPRequest } from "@hoppscotch/data"

// Import services and utilities
import { SOAPTabService } from "../services/tab/soap"
import { createSOAPNetworkRequestStream } from "../helpers/soap/soap-network"
import { useSOAPHistoryStore } from "../newstore/SOAPHistory"
import { getDefaultSOAPRequest } from "../helpers/soap/default"
import { useToast } from "../composables/toast"

// Import the components
import Request from "../components/soap/Request.vue"
import Response from "../components/soap/Response.vue"
import History from "../components/soap/History.vue"
import Collections from "../components/soap/Collections.vue"

const { t } = useI18n()
const toast = useToast()

const tabService = useService(SOAPTabService)
const sidebarTab = ref("history")

// New project modal state
const showNewProjectModal = ref(false)

const tabs = tabService.tabs
const selectedTabID = computed({
  get: () => tabService.activeTabID?.value ?? (tabs.value[0]?.id ?? ""),
  set: (value) => tabService.setActiveTab(value),
})

// Using a constant value since we may need to define the settings differently
const isResponseSideBySide = ref(true)
const showConfirmTabClose = ref(false)
const tabToClose = ref("")

const historyStore = useSOAPHistoryStore()

// Tab management state
const showSaveSampleModal = ref(false)
const showTabMenu = ref(false)
const showRenameModal = ref(false)
const sampleName = ref("")
const tabName = ref("")
const currentMenuTabID = ref("")

// SOAP Project modal state and functions
const projectName = ref("")
const wsdlUrl = ref("")
const createSampleRequests = ref(true)
const createTestSuite = ref(false)

// Validation
const isProjectFormValid = computed(() => {
  return !!projectName.value.trim() && !!wsdlUrl.value.trim()
})

// Browse for WSDL file
const browseWsdlFile = () => {
  // Create an invisible file input element
  const fileInput = document.createElement('input')
  fileInput.type = 'file'
  fileInput.accept = '.wsdl,.xml'
  
  // Handle file selection
  fileInput.onchange = async (event) => {
    const target = event.target as HTMLInputElement
    if (target.files && target.files.length > 0) {
      const file = target.files[0]
      
      try {
        // Read the file contents
        await readFileAsText(file) // Validate that the file can be read
        
        // If file looks valid, use the file name as the project name if not already set
        if (!projectName.value) {
          projectName.value = file.name.replace(/\.(wsdl|xml)$/i, '')
        }
        
        // Create a data URL for the WSDL file
        wsdlUrl.value = URL.createObjectURL(file)
        
        toast.success(`WSDL file loaded: ${file.name}`)
      } catch (error) {
        toast.error(`Error reading WSDL file: ${error instanceof Error ? error.message : 'Unknown error'}`)
      }
    }
  }
  
  // Trigger the file dialog
  fileInput.click()
}

// Helper function to read a file as text
const readFileAsText = (file: File): Promise<string> => {
  return new Promise((resolve, reject) => {
    const reader = new FileReader()
    reader.onload = () => resolve(reader.result as string)
    reader.onerror = () => reject(new Error('Failed to read file'))
    reader.readAsText(file)
  })
}

// Create SOAP project
const createProject = async () => {
  if (!isProjectFormValid.value) {
    toast.error(t('error.incomplete_form'))
    return
  }
  
  toast.info(`Creating SOAP project: ${projectName.value}`)
  
  try {
    // Create default SOAP envelope
    const defaultSoapBody = `<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Header>
  </soap:Header>
  <soap:Body>
    <!-- Add operation elements here -->
  </soap:Body>
</soap:Envelope>`

    // Create a new tab with the project
    const newTab = tabService.createNewTab({
      type: "request",
      request: makeSOAPRequest({
        name: projectName.value,
        endpoint: "",
        wsdl: wsdlUrl.value,
        auth: {
          authActive: false,
          authType: "none",
        },
        body: defaultSoapBody,
        headers: [],
        method: "POST",
      }),
      response: null,
    })

    // Set as active tab
    tabService.setActiveTab(newTab)
    
    // Hide the modal
    showNewProjectModal.value = false
    
    toast.success(t('soap.project_created'))
  } catch (error) {
    toast.error(`Error creating project: ${error instanceof Error ? error.message : 'Unknown error'}`)
  }
}

// Tab management
const addTab = () => {
  console.log('[soap.vue] Adding new tab')
  const newTab = tabService.createNewTab({
    type: "request", 
    request: getDefaultSOAPRequest(),
    response: null,
  })
  tabService.setActiveTab(newTab)
}

const closeTab = (tabID: string) => {
  console.log('[soap.vue] Closing tab:', tabID)
  tabService.closeTab(tabID)
  showConfirmTabClose.value = false
}

const confirmTabClose = (tabID: string) => {
  tabToClose.value = tabID
  showConfirmTabClose.value = true
}

const openTabMenu = (tabID: string) => {
  currentMenuTabID.value = tabID
  showTabMenu.value = true
}

const duplicateCurrentTab = () => {
  if (!currentMenuTabID.value) return
  
  const sourceTab = tabs.value.find(t => t.id === currentMenuTabID.value)
  if (!sourceTab) return
  
  const newTab = tabService.createNewTab({
    type: "request",
    request: makeSOAPRequest({
      ...sourceTab.document.request,
      name: `${sourceTab.document.request.name} (Copy)`,
    }),
    response: null,
  })
  
  tabService.setActiveTab(newTab)
  showTabMenu.value = false
}

const openSaveSampleModal = () => {
  showTabMenu.value = false
  showSaveSampleModal.value = true
}

const saveAsSample = () => {
  // Implementation for saving as sample
  showSaveSampleModal.value = false
  toast.success(`Sample saved: ${sampleName.value}`)
}

const renameCurrentTab = () => {
  showTabMenu.value = false
  
  const currentTab = tabs.value.find(t => t.id === currentMenuTabID.value)
  if (!currentTab) return
  
  tabName.value = currentTab.document.request.name
  showRenameModal.value = true
}

const saveTabRename = () => {
  if (!currentMenuTabID.value || !tabName.value.trim()) return
  
  const tabIndex = tabs.value.findIndex(t => t.id === currentMenuTabID.value)
  if (tabIndex === -1) return
  
  tabs.value[tabIndex].document.request.name = tabName.value.trim()
  showRenameModal.value = false
}

// Send a SOAP request
const sendRequest = async (tabID: string) => {
  const tabIndex = tabs.value.findIndex(t => t.id === tabID)
  if (tabIndex === -1) return
  
  const tab = tabs.value[tabIndex]
  const request = tab.document.request
  
  try {
    // Show the request is loading
    tabs.value[tabIndex].document.response = { type: "loading" }
    
    // Create request stream
    const reqStream = createSOAPNetworkRequestStream(request)
    
    // Subscribe to response
    reqStream.subscribe({
      next: (value) => {
        if (value.type === "response") {
          tabs.value[tabIndex].document.response = value
          
          // Log to history
          if (value.success) {
            historyStore.addEntry({
              request,
              responseMeta: {
                duration: value.meta.responseDuration,
                statusCode: value.statusCode,
              },
              star: false,
              updatedOn: Date.now(),
            })
          }
        } else {
          tabs.value[tabIndex].document.response = value
        }
      },
      error: (error) => {
        console.error("Request error:", error)
        
        // Show error response
        tabs.value[tabIndex].document.response = {
          type: "network_fail",
          error: error instanceof Error ? error.message : String(error),
        }
      },
    })
  } catch (error) {
    console.error("Send request error:", error)
    
    toast.error(`Error sending request: ${error instanceof Error ? error.message : 'Unknown error'}`)
    
    // Reset response to null on error
    tabs.value[tabIndex].document.response = null
  }
}

// Function to open the new project modal with animation
const openNewProjectModal = () => {
  // Reset form values to ensure fresh start
  projectName.value = ""
  wsdlUrl.value = ""
  createSampleRequests.value = true
  createTestSuite.value = false
  
  // Show the modal with nextTick to ensure the UI updates properly
  nextTick(() => {
    showNewProjectModal.value = true
    console.log("showNewProjectModal set to:", showNewProjectModal.value)
  })
  
  // Focus the project name input (in next tick to ensure DOM is updated)
  nextTick(() => {
    const projectNameInput = document.getElementById('projectName')
    if (projectNameInput) {
      projectNameInput.focus()
    }
  })
  
  console.log("showNewProjectModal set to:", showNewProjectModal.value)
}

// Watch for changes to the showNewProjectModal value
watch(showNewProjectModal, (newVal) => {
  console.log("showNewProjectModal changed to:", newVal)
});

// Set up sending requests when a tab needs to send
watch(
  () => tabs.value.map((t: any) => t.document.response),
  () => {
    console.log('[soap.vue] watch tabs:', tabs.value)
    // Find tabs that have a loading response and send their requests
    tabs.value.forEach((tab: any) => {
      if (tab.document.response && 'type' in tab.document.response && 
          tab.document.response.type === "loading") {
        sendRequest(tab.id)
      }
    })
  },
  { deep: true }
)

// No need for a separate export with script setup
// The component name is automatically inferred from the filename
</script>
